<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XKantor.LocalAgent.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <UserSecretsId>xkantor-local-agent-service</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sterownik PEZET (wysw8.exe + WYSW8.DLL, zadanie pezet\realizacja.txt) - kopiowany obok
         zbudowanego .exe zarówno przy 'dotnet run'/F5 (dev) jak i 'dotnet publish' (instalator,
         patrz installer\XKantorLocalAgent.iss), żeby Wysw8PezetAdapter
         (AppContext.BaseDirectory\pezet\wysw8.exe) zawsze go znalazł bez ręcznego kopiowania. -->
    <None Include="..\..\assets\pezet\**" CopyToOutputDirectory="PreserveNewest" LinkBase="pezet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XKantor.LocalAgent.Core\XKantor.LocalAgent.Core.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.Security\XKantor.LocalAgent.Security.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.Api\XKantor.LocalAgent.Api.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.Printing\XKantor.LocalAgent.Printing.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.Devices\XKantor.LocalAgent.Devices.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.Monitors\XKantor.LocalAgent.Monitors.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.CurrencyDisplay\XKantor.LocalAgent.CurrencyDisplay.csproj" />
    <ProjectReference Include="..\XKantor.LocalAgent.Board\XKantor.LocalAgent.Board.csproj" />
  </ItemGroup>

</Project>
